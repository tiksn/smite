<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>TIKSN.smite.cli</RootNamespace>

    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>smite</ToolCommandName>
    <PackageId>smite-cli</PackageId>
    <Authors>TIKSN</Authors>
    <Company>TIKSN Lab</Company>
    <Product>smite</Product>
    <Version>2.2.1</Version>
    <PackageProjectUrl>https://github.com/tiksn/smite</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Argu" Version="6.2.4" />
    <PackageReference Include="TIKSN-Framework" Version="5.3.0" />
    <PackageReference Include="YamlDotNet" Version="16.1.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.0" />
    <PackageReference Update="FSharp.Core" Version="8.0.400" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\smite-lib\smite-lib.fsproj" />
  </ItemGroup>

</Project>
