<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>TIKSN.smite.lib</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="SerializationModels.fs" />
    <Compile Include="CommonFeatures.fs" />
    <Compile Include="IndentationFeatures.fs" />
    <Compile Include="TypeScriptTranspiler.fs" />
    <Compile Include="FSharpTranspiler.fs" />
    <Compile Include="RoslynTranspiler.fs" />
    <Compile Include="VisualBasicTranspiler.fs" />
    <Compile Include="CSharpTranspiler.fs" />
    <Compile Include="Parser.fs" />
    <Compile Include="Saving.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis" Version="5.3.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.Common" Version="5.3.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.Features" Version="5.3.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.Common" Version="5.3.0" />
    <PackageReference Include="TIKSN-Framework" Version="5.6.5" />
    <PackageReference Include="YamlDotNet" Version="16.3.0" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="FSharp.Core" Version="10.1.203" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.8" />
  </ItemGroup>

</Project>
